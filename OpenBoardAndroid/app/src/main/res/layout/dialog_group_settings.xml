<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Avatar Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="群组头像"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"/>

        <ImageView
            android:id="@+id/iv_group_avatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_group"
            android:background="@drawable/bg_avatar_circle"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="群头像"
            android:layout_marginBottom="16dp"/>

        <!-- Group Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="群聊名称"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_group_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入群组名称"
            android:inputType="text"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp"/>

        <!-- View Mode (0: Public, 1: Whitelist Private) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看权限模式"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rg_view_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rb_view_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="公开 (拉黑禁看)"
                android:textSize="13sp"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rb_view_private"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="私密 (白名单可看)"
                android:textSize="13sp"/>
        </RadioGroup>

        <!-- View Black & White lists -->
        <EditText
            android:id="@+id/et_black_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="查看黑名单 (逗号分隔用户名)"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_white_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="查看白名单 (逗号分隔用户名)"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp"/>

        <!-- Speak Mode (0: Public, 1: Whitelist Speak) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发言权限模式"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rg_speak_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rb_speak_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="公开 (拉黑禁言)"
                android:textSize="13sp"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/rb_speak_private"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全员禁言 (白名单发言)"
                android:textSize="13sp"/>
        </RadioGroup>

        <!-- Speak Black & White lists -->
        <EditText
            android:id="@+id/et_black_speak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="发言黑名单 (逗号分隔用户名)"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_white_speak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="发言白名单 (逗号分隔用户名)"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- Delete Group Button -->
        <Button
            android:id="@+id/btn_disband_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="解散此群组"
            android:textAllCaps="false"
            android:textColor="#FF3B30"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

    </LinearLayout>
</ScrollView>
