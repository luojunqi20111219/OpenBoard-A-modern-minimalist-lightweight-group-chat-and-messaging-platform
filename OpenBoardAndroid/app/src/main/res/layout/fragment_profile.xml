<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_gradient"
        android:elevation="6dp"
        app:titleTextColor="@android:color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Gradient Profile Header -->
            <RelativeLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingHorizontal="24dp"
                android:paddingBottom="36dp"
                android:paddingTop="20dp">

                <!-- Avatar -->
                <FrameLayout
                    android:id="@+id/avatar_container"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_person"
                        android:background="@drawable/bg_avatar_circle"
                        android:scaleType="centerCrop"
                        android:padding="16dp"
                        android:contentDescription="头像"/>
                </FrameLayout>

                <!-- User Information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/avatar_container"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"/>

                    <TextView
                        android:id="@+id/tv_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击设置昵称"
                        android:textSize="13.5sp"
                        android:textColor="#CCFFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- Settings Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="安全与账户"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="4dp"/>

                <!-- Password Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/pwd_old"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="原密码"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/pwd_new"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="新密码"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_change_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="修改密码"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <!-- Section Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号管理"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp"
                    android:layout_marginTop="8dp"/>

                <!-- Login Devices & Security Management Button -->
                <Button
                    android:id="@+id/btn_devices"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📱 登录设备与账号安全"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- Mini Game Center Button -->
                <Button
                    android:id="@+id/btn_game"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🎮 休闲小游戏"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- My QR Code Button -->
                <Button
                    android:id="@+id/btn_qr_code"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="我的二维码名片"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- Theme Button -->
                <Button
                    android:id="@+id/btn_theme"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="个性化主题"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- Blacklist Button -->
                <Button
                    android:id="@+id/btn_blacklist"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="已拉黑用户名单"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- Logout Button -->
                <Button
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="退出登录"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <!-- Delete Account Button -->
                <Button
                    android:id="@+id/btn_delete_account"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="永久注销我的账号"
                    android:textAllCaps="false"
                    android:textColor="#E53935"
                    android:textSize="15sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_marginBottom="24dp"/>

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
