<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Logo / Title -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_send_btn">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    android:contentDescription="Logo"
                    android:tint="@android:color/white"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信语"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"/>

            <!-- Switch Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_tab_login"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="登录"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textStyle="bold"
                    android:textColor="@color/primary"/>

                <Button
                    android:id="@+id/btn_tab_register"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="注册"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

            <!-- Server URL -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="服务器地址"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:text="https://liuyan.luojunqi.xyz/"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Username -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="用户名"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nickname (Visible only for registration) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="昵称（选填）"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="密码"
                android:layout_marginBottom="24dp"
                app:passwordToggleEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action Button -->
            <Button
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="立即登录"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button"/>

            <!--
              登录错误提示区（默认隐藏）。

              为什么不用 Toast：登录失败的说明比较长，而且「联系管理员」这个
              场景下用户必须能把管理员名字记住/复制走，还要能回头再看一遍。
              Toast 一闪而过且无法选中文字，做不到这些。

              服务端在账号需要重置密码时返回 400 + PASSWORD_RESET_REQUIRED，
              由 LoginActivity 填充这里的文案与联系人。
            -->
            <LinearLayout
                android:id="@+id/box_login_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_login_error"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning_text"
                    tools:text="该账号需要重置密码"/>

                <TextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/warning_text"
                    tools:text="请联系管理员为你重置密码，重置后即可用新密码登录。"/>

                <!--
                  管理员名单：只显示用户名（服务端下发的本就是公开信息）。
                  textIsSelectable 让用户能长按复制，方便直接发给管理员。
                -->
                <TextView
                    android:id="@+id/tv_admin_names"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/warning_text"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    tools:text="官方账号 · Forest_siri"/>

                <!--
                  自助重置：服务端 400 响应里带 self_service=true 时显示。

                  这是「联系管理员」那句话的替代方案 —— admins 字段里只有
                  站内用户名（不是微信/QQ/邮箱），用户拿到名字也无处可发，
                  所以必须给一条自己能走通的路。
                -->
                <Button
                    android:id="@+id/btn_reset_default"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:minWidth="0dp"
                    android:text="重置为默认密码"
                    android:textSize="14sp"
                    android:backgroundTint="@color/warning_border"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button"/>

                <Button
                    android:id="@+id/btn_contact_admin"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="查看联系方式"
                    android:textSize="13sp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@color/warning_text"
                    android:visibility="gone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            </LinearLayout>

            <!--
              重置成功提示。

              重置成功后原来的橙色警示卡片就过时了（用户已经知道怎么做了），
              所以换成一块绿色卡片告诉他「下一步该干什么」：
              密码是 12345678，去点登录，登录后必须改密码。
            -->
            <LinearLayout
                android:id="@+id/box_login_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_login_success"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_success_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/success_text"
                    tools:text="密码已重置"/>

                <TextView
                    android:id="@+id/tv_success_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/success_text"
                    tools:text="请用默认密码 12345678 登录，登录后系统会要求您立即设置新密码。"/>

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="More"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:tint="@color/primary"/>

</androidx.constraintlayout.widget.ConstraintLayout>
