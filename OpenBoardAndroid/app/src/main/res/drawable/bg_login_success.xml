<?xml version="1.0" encoding="utf-8"?>
<!--
  登录成功卡片背景（密码重置完成后的提示）。

  与 bg_login_error 结构完全一致 —— 浅绿底 + 左侧深绿竖条 + 圆角，
  只是换了色系，让用户一眼看出「这一步过了，该去登录了」。

  刻意保持两套 drawable 分开而不是加个参数：颜色是写死的资源引用，
  共用一份反而让下次改色时容易漏掉一边。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡片本体 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/success_bg"/>
            <stroke android:width="1dp" android:color="@color/success_border"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <!-- 左侧强调色带 -->
    <item android:width="4dp" android:gravity="left|start">
        <shape android:shape="rectangle">
            <solid android:color="@color/success_border"/>
            <corners
                android:topLeftRadius="10dp"
                android:bottomLeftRadius="10dp"/>
        </shape>
    </item>
</layer-list>
