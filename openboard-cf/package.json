{
  "name": "openboard-cf",
  "version": "9.0.0",
  "private": true,
  "description": "信语 OpenBoard — Cloudflare Workers 版本",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build-fflate.mjs && node scripts/build-import.mjs",
    "bundle:do": "esbuild src/durable/chat.ts --bundle --format=esm --outfile=dist/do-test.js --external:cloudflare:workers",
    "preflight": "npm run bundle && node scripts/preflight.mjs",
    "check:android": "npm run bundle:do && npm run bundle && node scripts/android-ws-check.mjs",
    "test:live": "node scripts/live-ws-test.mjs",
    "test:import": "npm run bundle && node scripts/import-test.mjs",
    "setup": "bash scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:worker": "wrangler deploy",
    "d1:create": "wrangler d1 create openboard-db",
    "d1:init": "wrangler d1 execute openboard-db --remote --file=./schema.sql",
    "d1:init-local": "wrangler d1 execute openboard-db --local --file=./schema.sql",
    "d1:dump-local": "bash scripts/local_d1_dump.sh",
    "r2:create": "wrangler r2 bucket create openboard-uploads",
    "kv:create": "wrangler kv namespace create openboard-kv",
    "cf-typegen": "wrangler types",
    "test:ui": "npm run bundle && node scripts/upload-ui-test.mjs",
    "test:all": "npm run test:import && npm run preflight && npm run check:android && npm run test:ui"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.144.0"
  }
}
