{
  "name": "openboard-cf",
  "version": "8.0.0",
  "private": true,
  "description": "信语 OpenBoard — Cloudflare Workers & Pages 版本",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "dev:api": "wrangler dev --config wrangler.worker.toml",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/worker.ts --bundle --format=esm --outfile=dist/worker.js --external:cloudflare:workers",
    "bundle:do": "esbuild src/durable/chat.ts --bundle --format=esm --outfile=dist/do-test.js --external:cloudflare:workers",
    "build:pages": "wrangler pages functions build functions --outdir dist/pages",
    "build:test": "npm run bundle:do && npm run build:pages",
    "preflight": "npm run bundle && node scripts/preflight.mjs",
    "check:android": "npm run bundle:do && npm run build:pages && node scripts/android-ws-check.mjs",
    "setup": "bash scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:do": "wrangler deploy --config wrangler.do.toml",
    "deploy:pages": "wrangler pages deploy public",
    "d1:create": "wrangler d1 create openboard-db",
    "d1:init": "wrangler d1 execute openboard-db --remote --file=./schema.sql",
    "d1:init-local": "wrangler d1 execute openboard-db --local --file=./schema.sql",
    "d1:dump-local": "bash scripts/local_d1_dump.sh",
    "r2:create": "wrangler r2 bucket create openboard-uploads",
    "kv:create": "wrangler kv namespace create openboard-kv",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.87.0"
  }
}